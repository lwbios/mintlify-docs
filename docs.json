{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Welcome to Valora -  Valora Documentation",
  "colors": {
    "primary": "#615fff",
    "light": "#4f39f6",
    "dark": "#7c86ff"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Comece agora",
        "groups": [
          {
            "group": "Visão geral",
            "pages": [
              "index",
              "quickstart",
              "api-authentication"
            ]
          },
          {
            "group": "Taxas",
            "pages": [
              "fees",
              "fees-calculator"
            ]
          },
          {
            "group": "Variado",
            "pages": [
              {
                "group": "Canais de suporte",
                "pages": [
                  "help-support"
                ]
              }
            ]
          }
        ],
        "icon": "rocket-launch"
      },
      {
        "tab": "Referência da API",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/erro-codes",
              "api-reference/transaction-failures",
              "api-reference/webhooks"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ],
        "icon": "code"
      },
      {
        "tab": "Projetos comunitários",
        "icon": "people-line",
        "pages": [
          "overview"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Referência da API",
          "href": "https://docs.valora.cash/api-reference/introduction",
          "icon": "code",
          "color": {
            "light": "#615fff",
            "dark": "#615fff"
          }
        },
        {
          "anchor": "Dashboard Valora",
          "icon": "solar-panel",
          "color": {
            "light": "#615fff",
            "dark": "#615fff"
          },
          "href": "https://dash.valora.cash"
        }
      ]
    }
  },
  "logo": "/logo/light.svg",
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "family": "Inter",
    "format": "woff2"
  }
}
